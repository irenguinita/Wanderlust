@page "/"
@rendermode InteractiveServer
@using FreshBlazorApp.Models
@inject ItineraryService Service
@inject NavigationManager Nav

<PageTitle>Departures — Wanderlust</PageTitle>

<div class="min-h-screen bg-[#f1e5c8] text-[#3b2a1e] font-['Futura','Century_Gothic','Trebuchet_MS',sans-serif] antialiased">

    <!-- 70s stripe band -->
    <div aria-hidden="true">
        <div class="h-2 bg-[#e8672a]"></div>
        <div class="h-2 bg-[#e9a825]"></div>
        <div class="h-2 bg-[#1f7a7a]"></div>
    </div>

    <!-- Terminal header -->
    <header class="bg-[#3b2a1e] text-[#f4ead2] sticky top-0 z-20 shadow-lg">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <span class="w-9 h-9 rounded-full bg-[#e8672a] text-[#3b2a1e] flex items-center justify-center text-lg font-black">✈</span>
                <span class="text-2xl font-black tracking-[0.25em]">WANDERLUST</span>
                <span class="hidden md:inline text-[11px] tracking-[0.3em] uppercase text-[#e9a825] border-l border-[#e9a825]/40 pl-4">
                    International Terminal
                </span>
            </div>

            <button @onclick='() => Nav.NavigateTo("/itinerary")'
                    class="flex items-center gap-3 bg-[#e9a825] hover:bg-[#f4ead2] text-[#3b2a1e] text-xs font-black tracking-[0.2em] uppercase px-5 py-2 rounded-full transition-colors cursor-pointer active:scale-95">
                <span>🧳 My Tickets</span>
                @if (BookingCount > 0)
                {
                    <span class="bg-[#c8372d] text-white rounded-full min-w-6 h-6 px-1.5 flex items-center justify-center text-[11px]">@BookingCount</span>
                }
            </button>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- LEFT: Solari departures board -->
            <section class="lg:col-span-5 bg-[#2a1f17] rounded-2xl border-[6px] border-[#3b2a1e] shadow-[0_12px_0_0_#1c1510] overflow-hidden">

                <!-- Board sign -->
                <div class="bg-[#1f7a7a] text-[#f4ead2] px-5 py-3 flex items-center justify-between">
                    <span class="font-black tracking-[0.35em] text-sm">DEPARTURES</span>
                    <span class="text-[10px] tracking-[0.3em] uppercase text-[#f4ead2]/70">Départs · 出発</span>
                </div>

                <!-- Controls -->
                <div class="p-4 space-y-3 border-b border-black/40 bg-[#33261c]">
                    <input type="text"
                           placeholder="SEARCH DESTINATION OR COUNTRY"
                           @bind="searchQuery" @bind:event="oninput"
                           class="w-full px-4 py-2 bg-[#f4ead2] border-2 border-[#e9a825] rounded-full text-xs font-bold tracking-widest uppercase text-[#3b2a1e] placeholder-[#3b2a1e]/40 focus:outline-none focus:border-[#e8672a] transition-colors" />

                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-1.5">
                            @foreach (var f in filters)
                            {
                                var active = filter == f.Key;
                                <button @onclick="() => SetFilter(f.Key)"
                                        class="@(active ? "bg-[#e8672a] text-[#2a1f17] border-[#e8672a]" : "text-[#f4ead2]/70 border-[#f4ead2]/30 hover:border-[#e9a825] hover:text-[#e9a825]") text-[11px] font-black uppercase tracking-widest px-3 py-1 rounded-full border-2 transition-colors cursor-pointer">
                                    @f.Value
                                </button>
                            }
                        </div>

                        <div class="flex items-center gap-2 text-[10px] font-bold tracking-widest uppercase text-[#f4ead2]/60">
                            <span>Stay</span>
                            <input type="range" min="1" max="14" @bind="previewDays" @bind:event="oninput" class="w-20 accent-[#e9a825] cursor-pointer" />
                            <span class="text-[#e9a825] tabular-nums w-8">@previewDays d</span>
                        </div>
                    </div>
                </div>

                <!-- Column headings -->
                <div class="grid grid-cols-[6rem_1fr_auto] gap-3 px-4 py-2 text-[10px] font-bold tracking-[0.25em] uppercase text-[#f4ead2]/40 border-b border-black/40">
                    <span>Flight</span>
                    <span>Destination</span>
                    <span class="text-right">Fare · 1 pax</span>
                </div>

                <!-- Rows -->
                <div class="max-h-[34rem] overflow-y-auto">
                    @if (!FilteredList.Any())
                    {
                        <div class="p-10 text-center text-[#f4ead2]/50 text-xs font-bold tracking-widest uppercase">
                            ✈ No flights match "@searchQuery"
                        </div>
                    }
                    else
                    {
                        @foreach (var p in FilteredList)
                        {
                            var active = Current?.Id == p.Id;
                            var est = p.CalculateTotal(previewDays, 1);
                            var st = Status(p);

                            <div @onclick="() => SelectPackage(p)"
                                 class="@(active ? "bg-[#4a3626] border-[#e8672a]" : "border-transparent hover:bg-[#33261c]") grid grid-cols-[6rem_1fr_auto] gap-3 items-center px-4 py-3 border-l-4 border-b border-b-black/40 cursor-pointer transition-colors">

                                @Flaps(Code(p), "text-[#f4ead2]", "w-7 h-9 text-lg")

                                <div class="min-w-0">
                                    <div class="text-sm font-black tracking-wide text-[#f4ead2] truncate">@p.Name.ToUpperInvariant()</div>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-[10px] font-bold uppercase tracking-widest text-[#f4ead2]/50">@p.Country</span>
                                        <span class="@st.Css text-[9px] font-black tracking-widest uppercase px-1.5 py-0.5 rounded-sm">@st.Label</span>
                                    </div>
                                </div>

                                <div class="flex items-center gap-1">
                                    <span class="text-[#e9a825] text-xs font-black">$</span>
                                    @Flaps(est.ToString("N0"), "text-[#e9a825]", "w-5 h-7 text-sm")
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>

            <!-- RIGHT: airmail-striped ticket jacket -->
            <section class="lg:col-span-7 lg:sticky lg:top-24">
                @if (Current is null)
                {
                    <div class="bg-[#f8f0dc] border-4 border-dashed border-[#3b2a1e]/30 rounded-2xl p-16 text-center text-[#3b2a1e]/50 text-xs font-bold tracking-[0.3em] uppercase">
                        <div class="text-6xl mb-3 opacity-60">🛫</div>
                        Select a flight from the board
                    </div>
                }
                else
                {
                    var cur = Current;
                    var isAdv = cur is AdventurePackage;

                    <!-- Airmail border -->
                    <div class="p-2.5 rounded-3xl shadow-[0_12px_0_0_rgba(59,42,30,0.25)]"
                         style="background: repeating-linear-gradient(135deg,#c8372d 0 14px,#f8f0dc 14px 22px,#1f5fa8 22px 36px,#f8f0dc 36px 44px);">
                        <div class="relative bg-[#f8f0dc] rounded-[1.25rem] overflow-hidden">

                            <!-- Stamp -->
                            <div class="absolute top-5 right-5 z-10 rotate-12 border-4 border-double border-[#c8372d] text-[#c8372d] rounded-lg px-3 py-1 text-center bg-[#f8f0dc]/80">
                                <div class="text-[9px] font-black tracking-[0.3em] uppercase">Approved</div>
                                <div class="text-sm font-black tracking-widest uppercase">@(isAdv ? "Expedition" : "Retreat")</div>
                            </div>

                            <!-- Airplane window -->
                            <div class="px-8 pt-8">
                                <div class="mx-auto max-w-md aspect-[4/3] rounded-[3rem] border-[10px] border-[#e4d6b4] ring-4 ring-[#3b2a1e] overflow-hidden bg-[#e4d6b4] shadow-inner">
                                    <img src="@cur.ImageUrl" alt="@cur.Name" class="w-full h-full object-cover" />
                                </div>
                            </div>

                            <div class="p-8 pt-6">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="min-w-0">
                                        <div class="text-[10px] font-bold tracking-[0.3em] uppercase text-[#3b2a1e]/50">Now Boarding To</div>
                                        <h1 class="text-3xl font-black tracking-tight leading-tight">@cur.Name</h1>
                                        <div class="text-sm font-bold text-[#1f7a7a]">📍 @cur.Country</div>
                                    </div>
                                    <div class="shrink-0 bg-[#e9a825] border-4 border-[#3b2a1e] rounded-xl px-3 py-1 text-center">
                                        <div class="text-[9px] font-black tracking-[0.25em] uppercase">Gate</div>
                                        <div class="text-2xl font-black leading-none">G@(cur.Id)</div>
                                    </div>
                                </div>

                                <p class="mt-4 text-sm leading-relaxed text-[#3b2a1e]/80 border-l-4 border-[#e8672a] pl-3">@cur.Description</p>

                                <!-- Ticket fields -->
                                <div class="mt-6 grid grid-cols-3 gap-4 border-y-2 border-dashed border-[#3b2a1e]/30 py-4 text-sm">
                                    <div>
                                        <div class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#3b2a1e]/50">Daily Fare</div>
                                        <div class="font-black tabular-nums">$@cur.BaseRatePerDay.ToString("N0")</div>
                                    </div>
                                    <div>
                                        <div class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#3b2a1e]/50">Status</div>
                                        <div class="font-black">@Status(cur).Label</div>
                                    </div>
                                    <div>
                                        <div class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#3b2a1e]/50">@(isAdv ? "Gear Surcharge" : "Hospitality Tax")</div>
                                        <div class="font-black tabular-nums">
                                            @if (cur is AdventurePackage a)
                                            {
                                                <span>$@a.GearFeePerPerson.ToString("N0") / guest</span>
                                            }
                                            else if (cur is ResortPackage r)
                                            {
                                                <span>@((r.ResortTaxRate * 100).ToString("0.#"))%</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Fare + action -->
                                <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
                                    <div>
                                        <div class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#3b2a1e]/50">
                                            Preview · @previewDays days × 1 guest
                                        </div>
                                        <div class="flex items-center gap-1 mt-1">
                                            <span class="text-[#e8672a] text-xl font-black mr-1">$</span>
                                            @Flaps(cur.CalculateTotal(previewDays, 1).ToString("N2"), "text-[#e9a825]", "w-7 h-10 text-xl")
                                        </div>
                                    </div>

                                    <button @onclick='() => Nav.NavigateTo($"/details/{cur.Id}")'
                                            class="bg-[#e8672a] hover:bg-[#3b2a1e] text-[#fff7e6] text-xs font-black tracking-[0.25em] uppercase py-3.5 px-7 rounded-full border-4 border-[#3b2a1e] shadow-[4px_4px_0_0_#3b2a1e] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all flex items-center gap-3 cursor-pointer">
                                        <span>Configure &amp; Reserve</span>
                                        <span class="text-base">✈</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </section>
        </div>
    </main>

    <div class="h-2 bg-[#1f7a7a]" aria-hidden="true"></div>
</div>

@code {
    private string filter = "All";
    private string searchQuery = "";
    private int previewDays = 3;
    private int? selectedId;

    private List<TravelPackage> allPackages = new();
    private int bookingCount;

    private readonly Dictionary<string, string> filters = new()
    {
        ["All"] = "All",
        ["Adventure"] = "Expeditions",
        ["Resort"] = "Retreats"
    };

    protected override async Task OnInitializedAsync()
    {
        allPackages = (await Service.GetPackagesAsync()).ToList();
        bookingCount = (await Service.GetBookingsAsync()).Count;
    }

    private int BookingCount => bookingCount;

    private List<TravelPackage> FilteredList =>
        allPackages
        .Where(p => (filter == "All" ||
                    (filter == "Adventure" && p is AdventurePackage) ||
                    (filter == "Resort" && p is ResortPackage))
                 && (string.IsNullOrWhiteSpace(searchQuery) ||
                     p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                     p.Country.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private TravelPackage? Current =>
        FilteredList.FirstOrDefault(p => p.Id == selectedId) ?? FilteredList.FirstOrDefault();

    private void SetFilter(string category) => filter = category;
    private void SelectPackage(TravelPackage p) => selectedId = p.Id;

    // 3-letter "airport code" from the country
    private static string Code(TravelPackage p) =>
        (p.Country.Length >= 3 ? p.Country[..3] : p.Country).ToUpperInvariant();

    // Departure-board status, decided by type
    private static (string Label, string Css) Status(TravelPackage p) => p switch
    {
        AdventurePackage { DifficultyLevel: "Extreme" } => ("Final Call", "bg-[#c8372d] text-white animate-pulse"),
        AdventurePackage => ("Boarding", "bg-[#e9a825] text-[#2a1f17]"),
        _ => ("On Time", "bg-[#1f7a7a] text-[#f4ead2]")
    };

    // Reusable split-flap characters (Solari style)
    private RenderFragment Flaps(string text, string textCss, string sizeCss) => @<div class="flex items-center gap-0.5">
        @foreach (var ch in text)
        {
            @if (ch == ',' || ch == '.')
            {
                <span class="text-[#f4ead2]/40 font-black">@ch</span>
            }
            else
            {
                <span class="@sizeCss @textCss relative bg-[#1c1510] font-black flex items-center justify-center rounded-[3px] tabular-nums shadow-[inset_0_-2px_0_rgba(0,0,0,0.6)]">
                    @ch
                    <span class="absolute inset-x-0 top-1/2 h-px bg-black/80"></span>
                </span>
            }
        }
    </div>;
}
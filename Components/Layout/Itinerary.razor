@page "/itinerary"
@rendermode InteractiveServer
@using FreshBlazorApp.Models
@inject ItineraryService Service
@inject NavigationManager Nav

<PageTitle>My Tickets — Wanderlust</PageTitle>

<div class="min-h-screen bg-[#f1e5c8] text-[#3b2a1e] font-['Futura','Century_Gothic','Trebuchet_MS',sans-serif] antialiased">

    <!-- 70s stripe band -->
    <div aria-hidden="true">
        <div class="h-2 bg-[#e8672a]"></div>
        <div class="h-2 bg-[#e9a825]"></div>
        <div class="h-2 bg-[#1f7a7a]"></div>
    </div>

    <!-- Terminal header -->
    <header class="bg-[#3b2a1e] text-[#f4ead2] sticky top-0 z-20 shadow-lg">
        <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <span class="w-9 h-9 rounded-full bg-[#e8672a] text-[#3b2a1e] flex items-center justify-center text-lg font-black">✈</span>
                <span class="text-2xl font-black tracking-[0.25em]">WANDERLUST</span>
                <span class="hidden md:inline text-[11px] tracking-[0.3em] uppercase text-[#e9a825] border-l border-[#e9a825]/40 pl-4">
                    Ticket Desk
                </span>
            </div>

            <button @onclick='() => Nav.NavigateTo("/")'
                    class="flex items-center gap-2 bg-[#e9a825] hover:bg-[#f4ead2] text-[#3b2a1e] text-xs font-black tracking-[0.2em] uppercase px-5 py-2 rounded-full transition-colors cursor-pointer active:scale-95">
                <span>←</span>
                <span>Departures</span>
            </button>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-8">

        <!-- Summary: Solari board -->
        <section class="bg-[#2a1f17] rounded-2xl border-[6px] border-[#3b2a1e] shadow-[0_12px_0_0_#1c1510] overflow-hidden mb-10">
            <div class="bg-[#1f7a7a] text-[#f4ead2] px-5 py-3 flex items-center justify-between">
                <span class="font-black tracking-[0.35em] text-sm">MY TICKETS</span>
                <span class="text-[10px] tracking-[0.3em] uppercase text-[#f4ead2]/70">Billets · 搭乗券</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-black/40">
                <div class="bg-[#33261c] p-6">
                    <div class="text-[10px] font-bold tracking-[0.3em] uppercase text-[#f4ead2]/50 mb-3">Total Trips Booked</div>
                    @Flaps(BookingCount.ToString(), "text-[#f4ead2]", "w-9 h-14 text-3xl")
                </div>

                <div class="bg-[#33261c] p-6">
                    <div class="text-[10px] font-bold tracking-[0.3em] uppercase text-[#e9a825] mb-3">Grand Total Fare</div>
                    <div class="flex items-center gap-1 flex-wrap">
                        <span class="text-[#e8672a] text-2xl font-black mr-1">$</span>
                        @Flaps(GrandTotal.ToString("N2"), "text-[#e9a825]", "w-7 h-11 text-2xl")
                    </div>
                </div>
            </div>
        </section>

        @if (BookingCount == 0)
        {
            <!-- Empty state -->
            <div class="bg-[#f8f0dc] border-4 border-dashed border-[#3b2a1e]/30 rounded-2xl p-16 text-center">
                <div class="text-6xl mb-3 opacity-60">🛫</div>
                <h2 class="text-2xl font-black tracking-[0.2em] uppercase">No Tickets Issued</h2>
                <p class="text-sm font-bold text-[#3b2a1e]/60 mt-2 mb-6">No trips planned yet. Explore destinations!</p>
                <button @onclick='() => Nav.NavigateTo("/")'
                        class="bg-[#e8672a] hover:bg-[#3b2a1e] text-[#fff7e6] text-xs font-black tracking-[0.25em] uppercase py-3.5 px-7 rounded-full border-4 border-[#3b2a1e] shadow-[4px_4px_0_0_#3b2a1e] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all cursor-pointer">
                    Explore Destinations ✈
                </button>
            </div>
        }
        else
        {
            <div class="space-y-8">
                @foreach (var b in Service.GetBookings())
                {
                    var pkg = b.PackageItem;
                    var isAdv = pkg is AdventurePackage;

                    <!-- Airmail border -->
                    <div class="p-2 rounded-3xl shadow-[0_10px_0_0_rgba(59,42,30,0.25)] hover:-rotate-1 transition-transform duration-200"
                         style="background: repeating-linear-gradient(135deg,#c8372d 0 14px,#f8f0dc 14px 22px,#1f5fa8 22px 36px,#f8f0dc 36px 44px);">

                        <div class="bg-[#f8f0dc] rounded-[1.1rem] overflow-hidden flex flex-col sm:flex-row">

                            <!-- Ticket body (click to view/cancel in details) -->
                            <div @onclick='() => Nav.NavigateTo($"/details/{pkg.Id}?bookingId={b.Id}")'
                                 class="flex-1 flex items-center gap-5 p-5 cursor-pointer group min-w-0">

                                <div class="w-24 h-24 shrink-0 rounded-full border-[6px] border-[#e4d6b4] ring-2 ring-[#3b2a1e] overflow-hidden bg-[#e4d6b4]">
                                    <img src="@pkg.ImageUrl" alt="@pkg.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                                </div>

                                <div class="min-w-0">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-2xl font-black tracking-[0.15em] leading-none text-[#e8672a]">@Code(pkg)</span>
                                        <span class="@(isAdv ? "bg-[#e8672a] text-[#2a1f17]" : "bg-[#1f7a7a] text-[#f4ead2]") text-[9px] font-black tracking-[0.25em] uppercase px-2 py-0.5 rounded-full">
                                            @(isAdv ? "🧗" : "🍹") @pkg.GetPackageType()
                                        </span>
                                    </div>

                                    <h3 class="text-xl font-black tracking-tight leading-tight truncate group-hover:text-[#e8672a] transition-colors">@pkg.Name</h3>
                                    <div class="text-xs font-bold text-[#1f7a7a]">📍 @pkg.Country</div>

                                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] font-bold tracking-[0.15em] uppercase text-[#3b2a1e]/60 mt-2">
                                        <span>📅 <strong class="text-[#3b2a1e]">@b.Days days</strong></span>
                                        <span>👯 <strong class="text-[#3b2a1e]">@b.Travelers guest@(b.Travelers > 1 ? "s" : "")</strong></span>
                                        <span>Gate <strong class="text-[#3b2a1e]">G@(pkg.Id)</strong></span>
                                    </div>
                                    <div class="text-[10px] font-bold tracking-[0.2em] uppercase text-[#3b2a1e]/40 mt-1">
                                        Issued @b.BookingDate.ToString("MMM d, yyyy · h:mm tt")
                                    </div>
                                </div>
                            </div>

                            <!-- Stub -->
                            <div class="relative bg-[#f4e6c0] border-t-2 sm:border-t-0 sm:border-l-2 border-dashed border-[#3b2a1e]/30 p-5 sm:w-64 shrink-0 flex sm:flex-col items-center sm:items-stretch justify-between gap-4">

                                <!-- perforation notches (desktop) -->
                                <div class="hidden sm:block absolute -left-3 -top-3 w-6 h-6 rounded-full bg-[#f1e5c8]"></div>
                                <div class="hidden sm:block absolute -left-3 -bottom-3 w-6 h-6 rounded-full bg-[#f1e5c8]"></div>

                                <div>
                                    <div class="text-[10px] font-bold tracking-[0.25em] uppercase text-[#3b2a1e]/50 mb-1">Total Fare</div>
                                    <div class="flex items-center gap-0.5 flex-wrap">
                                        <span class="text-[#e8672a] text-sm font-black mr-0.5">$</span>
                                        @Flaps(b.TotalCost.ToString("N2"), "text-[#e9a825]", "w-4 h-6 text-xs")
                                    </div>
                                </div>

                                <button @onclick="() => Cancel(b.Id)"
                                        class="bg-[#c8372d] hover:bg-[#3b2a1e] text-white text-[11px] font-black tracking-[0.2em] uppercase py-2.5 px-4 rounded-full border-4 border-[#3b2a1e] shadow-[3px_3px_0_0_#3b2a1e] hover:shadow-none hover:translate-x-0.5 hover:translate-y-0.5 transition-all cursor-pointer active:scale-95 whitespace-nowrap">
                                    🗑️ Cancel Trip
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <div class="h-2 bg-[#1f7a7a] mt-4" aria-hidden="true"></div>
</div>

@code {
    private int BookingCount => Service?.GetBookings()?.Count ?? 0;
    private decimal GrandTotal => Service?.CalculateGrandTotal() ?? 0;

    private void Cancel(Guid id) => Service?.RemoveBooking(id);

    // 3-letter "airport code" from the country (same as Home)
    private static string Code(TravelPackage p) =>
        (p.Country.Length >= 3 ? p.Country[..3] : p.Country).ToUpperInvariant();

    // Reusable split-flap characters (Solari style, same as Home)
    private RenderFragment Flaps(string text, string textCss, string sizeCss) => @<div class="flex items-center gap-0.5">
        @foreach (var ch in text)
        {
            @if (ch == ',' || ch == '.')
            {
                <span class="text-[#f4ead2]/40 font-black">@ch</span>
            }
            else
            {
                <span class="@sizeCss @textCss relative bg-[#1c1510] font-black flex items-center justify-center rounded-[3px] tabular-nums shadow-[inset_0_-2px_0_rgba(0,0,0,0.6)]">
                    @ch
                    <span class="absolute inset-x-0 top-1/2 h-px bg-black/80"></span>
                </span>
            }
        }
    </div>;
}